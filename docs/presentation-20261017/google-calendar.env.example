# Proposed configuration contract only. No integration code reads these yet.
GOOGLE_CALENDAR_ENABLED=false
GOOGLE_CALENDAR_CLIENT_ID=replace-with-oauth-client-id
GOOGLE_CALENDAR_CLIENT_SECRET=provision-via-runtime-secret
GOOGLE_CALENDAR_REDIRECT_URI=https://your-domain.example/api/integrations/google-calendar/callback
GOOGLE_CALENDAR_WEBHOOK_URL=https://your-domain.example/api/integrations/google-calendar/webhook
GOOGLE_CALENDAR_TIMEZONE=Asia/Bangkok
GOOGLE_CALENDAR_POLL_INTERVAL_SECONDS=300
