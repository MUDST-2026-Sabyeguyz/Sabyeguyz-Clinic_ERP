POSTGRES_DB=clinic_erp_v2
POSTGRES_USER=clinic
POSTGRES_PASSWORD=replace-with-a-local-password
JWT_SECRET=replace-with-at-least-32-random-characters
POSTGRES_PORT=5432
BACKEND_PORT=8080
FRONTEND_PORT=80
# First install only: choose your own manager credentials (password >=12 characters).
# Remove these values after provisioning; existing accounts are never overwritten.
CLINIC_BOOTSTRAP_MANAGER_USERNAME=
CLINIC_BOOTSTRAP_MANAGER_PASSWORD=

# Google Calendar sync (optional; use together with compose.calendar.yaml). Path of the service account JSON key
# on the server; keep the file outside the repository.
# CALENDAR_KEY_FILE=/opt/sabyeguyz/secrets/calendar-sync-key.json
