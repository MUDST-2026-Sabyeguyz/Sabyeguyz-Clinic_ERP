POSTGRES_DB=clinic_erp_v2
POSTGRES_USER=clinic
POSTGRES_PASSWORD=replace-with-a-local-password
JWT_SECRET=replace-with-at-least-32-random-characters
POSTGRES_PORT=5432
BACKEND_PORT=8080
FRONTEND_PORT=80
# Demo seed is off by default. To seed a disposable local database, set both values explicitly:
# CLINIC_DATABASE_KIND=local-demo
# CLINIC_SEED_MODE=full
CLINIC_DATABASE_KIND=unspecified
CLINIC_SEED_MODE=none
# First install only: choose your own manager credentials (password >=12 characters).
# Remove these values after provisioning; existing accounts are never overwritten.
CLINIC_BOOTSTRAP_MANAGER_USERNAME=
CLINIC_BOOTSTRAP_MANAGER_EMAIL=
CLINIC_BOOTSTRAP_MANAGER_PASSWORD=

# Google Calendar sync (optional; use together with compose.calendar.yaml). Path of the service account JSON key
# on the server; keep the file outside the repository.
# CALENDAR_KEY_FILE=/opt/sabyeguyz/secrets/calendar-sync-key.json

# Demo data (branches, patients, demo accounts with publicly known passwords). Local/dev ONLY - never enable in production.
# APP_V2_FLYWAY_EXTRA_LOCATIONS=,classpath:db/seed_v2
# Origins allowed to call the API from a browser (comma separated). Leave empty when the frontend is served from the same origin.
# APP_CORS_ALLOWED_ORIGINS=http://localhost:5173
