{
  "name": "clinic-erp-backend-tests",
  "version": "0.0.0",
  "private": true,
  "description": "Cypress HTTP API tests for the Spring Boot backend",
  "scripts": {
    "test": "npm run build && npm run test:api",
    "build": "mvn --batch-mode --no-transfer-progress clean package",
    "test:api": "node scripts/run-api-tests.cjs",
    "test:api:open": "node scripts/run-api-tests.cjs --open",
    "test:v2": "node scripts/run-v2-tests.cjs",
    "test:v2:open": "node scripts/run-v2-tests.cjs --open"
  },
  "devDependencies": {
    "cypress": "16.1.0"
  },
  "engines": {
    "node": "^22.18.0 || >=24.12.0"
  }
}
